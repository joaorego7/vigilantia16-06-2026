<!-- templates/report.html.j2 -->
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8">
    <title>Relatório RGPD - {{ site_url }}</title>
  </head>
  <body>
    <h1>Relatório RGPD para {{ site_url }}</h1>

    <h2>Resumo por severidade</h2>
    <ul>
      <li>Problemas graves (high): {{ summary.high }}</li>
      <li>Problemas médios (medium): {{ summary.medium }}</li>
      <li>Problemas baixos (low): {{ summary.low }}</li>
    </ul>

    <h2>Detalhe das não-conformidades</h2>
    <ul>
      {% for f in findings %}
        <li>
          [{{ f.severity }}] {{ f.id }} - {{ f.description }}<br>
          <strong>Recomendação:</strong> {{ f.recommendation }}<br>
          <strong>Evidência:</strong>
          {% if f.evidence is mapping %}
            {{ f.evidence.get("message") }}
          {% else %}
            {{ f.evidence }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    <h2>Teste de Cookies Pré-Consentimento (Fase 2)</h2>
    <p>Foram encontrados {{ total_cookies }} cookies instalados ANTES de qualquer consentimento.</p>
    {% if tracking_cookies %}
      <p style="color: red;"><strong>ATENÇÃO:</strong> Foram detetados {{ tracking_cookies|length }} cookies de tracking/analytics!</p>
      <ul>
        {% for c in tracking_cookies %}
          <li>Nome: {{ c.name }} | Domínio: {{ c.domain }}</li>
        {% endfor %}
      </ul>
      <p style="color: red;">Isto é uma possível violação grave do RGPD (falta de opt-in).</p>
    {% else %}
      <p style="color: green;"><strong>Excelente:</strong> Não foram detetados cookies de tracking óbvios antes do consentimento.</p>
    {% endif %}

    <hr>
    <p><strong>Aviso legal:</strong> {{ legal_disclaimer }}</p>
  </body>
</html>