# Copiar para .env e ajustar. .env já está no .gitignore.

# =============================================
# Base de Dados Local (SQLite por omissão)
# =============================================
# Tipo de BD local: 'sqlite' (portátil, padrão), 'mssql' (retrocompat.) ou 'none' (sem persistência local).
VIGILANTIA_DB_TYPE=sqlite

# Caminho para o ficheiro SQLite (só usado quando DB_TYPE=sqlite).
VIGILANTIA_SQLITE_PATH=vigilantia.db

# =============================================
# Dashboard de Incidências (MSSQL Remoto via SP)
# =============================================
# Ativar o envio de incidências para o dashboard remoto (true/false).
VIGILANTIA_DASHBOARD_ENABLED=false

# Modo dry-run: imprime o SQL que seria executado, sem ligar à BD (true/false).
VIGILANTIA_DASHBOARD_DRY_RUN=false

# Servidor MSSQL remoto onde está o dashboard.
VIGILANTIA_DASHBOARD_SERVER=
VIGILANTIA_DASHBOARD_NAME=
VIGILANTIA_DASHBOARD_DRIVER=ODBC Driver 18 for SQL Server

# Autenticação (SQL Auth por omissão - requer user/password)
VIGILANTIA_DASHBOARD_TRUSTED=false
VIGILANTIA_DASHBOARD_USER=
VIGILANTIA_DASHBOARD_PASSWORD=
VIGILANTIA_DASHBOARD_TRUST_CERT=true

# Parâmetros do SP [service].[create_notification]
VIGILANTIA_CLIENT_ID=
VIGILANTIA_DEVICE_ID=0
VIGILANTIA_AUDIT_TYPE=website_audit
